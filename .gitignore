# ─────────────────────────────────────────────────────────────────────────────
# favor-skills .gitignore
# This repo is the canonical source for skills (symlinked into ~/.claude, etc.).
# It should contain ONLY skill source: SKILL.md, README.md, scripts/, refs.
# Everything below is generated, machine-local, or sensitive — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets / credentials ────────────────────────────────────────────────────
# The resend skill sources SMTP app-password creds from .bump_env. Never commit.
.bump_env
.env
.env.*
*.env
secrets.*
*.pem
*.key
# ...but keep templated examples so the setup is documented:
!.env.example
!.env.sample
!.env.template

# ── Skill runtime artifacts (PII: real attendee names/emails) ────────────────
# The resend/export pipelines write these to the working dir. They must never
# land in the repo — they contain real attendee data and live send progress.
attendees*.csv
sent_*.jsonl
sent_all.jsonl
bounced*.txt
recipient*.csv
*_bump_list*.csv
*_state.jsonl
*_state.jsonl.*.bak
*_run.log
*.bak

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
# Virtual envs
.venv/
venv/
env/
ENV/

# ── Node (in case a future skill ships JS tooling) ──────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Logs & temp ──────────────────────────────────────────────────────────────
*.log
*.tmp
tmp/
.cache/

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
